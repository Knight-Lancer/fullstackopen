# Copy this file to .env and configure your own Atlas cluster.
# For the backend, set MONGODB_URI in your hosting dashboard or shell.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/phonebook?retryWrites=true&w=majority
# For Exercise 3.12 CLI, the password is supplied as the first command-line argument.
MONGODB_URI_TEMPLATE=mongodb+srv://USERNAME:<password>@YOUR-CLUSTER.mongodb.net/phonebook?retryWrites=true&w=majority
